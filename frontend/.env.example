# Browser-exposed environment variables only.
#
# VITE_* variables are embedded into the client bundle and are publicly
# readable. Never put database passwords, private API keys, storage secrets,
# payment secret keys, or webhook secrets in this file.
#
# Copy this file to .env for local development. .env is git-ignored.

# Base URL of the Wise Grade API.
#
# Local development: the backend default, http://localhost:4000.
#
# Production (Vercel) has two supported modes:
#
#   1. Same-origin proxy (recommended, and required for reliable iOS Safari
#      sessions). Set:
#
#        VITE_API_URL=same-origin
#
#      The browser calls /api/... on https://wisegrade.app and the rewrite in
#      vercel.json forwards it to https://wisegradebackend.vercel.app/api/...
#      The session cookie is first-party, so Safari's cross-site cookie
#      blocking does not apply. For local development with this value, the Vite
#      dev server proxies /api to http://localhost:4000. Override the target
#      with VITE_API_PROXY_TARGET if the backend runs elsewhere.
#
#   2. Direct backend origin (legacy). Set:
#
#        VITE_API_URL=https://<deployed-backend-origin>
#
#      This requires CORS on the backend and a third-party-compatible session
#      cookie. It is retained for separate-origin deployments but is not
#      recommended for Apple devices.
#
#      Project -> Settings -> Environment Variables on Vercel.
#
# Use an origin only: scheme + host, no trailing slash, no /api path.
# `npm run build` rejects a malformed direct origin. A missing value in a
# production build selects same-origin proxy mode automatically.
VITE_API_URL=http://localhost:4000

