{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api",
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/$1"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "dist/**"
    }
  },
  "crons": [
    {
      "path": "/api/internal/calendar",
      "schedule": "0 1 * * *"
    }
  ]
}
