# Gradely backend environment template.
#
# Copy this file to .env for LOCAL DEVELOPMENT and replace every placeholder
# with real local values. Never commit .env or any real credentials.
#
# Environment profiles are explicit and never inferred:
#   .env                     local development (loaded by default)
#   .env.production.local    production/Neon values for local tooling only
#   .env.test                optional test-only overrides
#
# Select a non-default profile with GRADELY_ENV_FILE, for example:
#   $env:GRADELY_ENV_FILE='.env.production.local'
#   npx prisma migrate status
#   Remove-Item Env:GRADELY_ENV_FILE
#
# Duplicate keys inside one file are rejected at load time. Never put both
# local and production DATABASE_URL values in the same file.
#
# Vercel does not read any .env file. Configure the same variables in the
# Vercel project (Production scope) and redeploy after changes.
#
# The API and GET /api/health work without DATABASE_URL or a running database.
# Database-backed functionality fails clearly until DATABASE_URL is configured.

# ---------------------------------------------------------------------------
# Application runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------------
# Browser origins (CORS and cookie CSRF protection)
# ---------------------------------------------------------------------------
# Comma-separated list of exact browser origins allowed to call the API.
# Format: scheme + host + optional port, no trailing slash, no path, no
# wildcard. Example:
#   CORS_ORIGINS=https://app.example.com,https://staging.example.com
#
# Required in production; each entry must be an HTTPS origin and must not be a
# localhost address. The API refuses to start otherwise.
#
# Production example (the deployed Gradely frontend):
#   CORS_ORIGINS=https://frontend-esf6.vercel.app
# No wildcard is ever allowed because session cookies require credentials.
#
# In development the local Vite origins http://localhost:5173,
# http://localhost:5174, http://127.0.0.1:5173 and http://127.0.0.1:5174 are
# always allowed in addition to the entries below, because Vite falls forward to
# the next free port when 5173 is already in use.
CORS_ORIGINS=http://localhost:5173

# Public frontend origin, used for links, redirects and the origin allow-list.
# Production: set this to the deployed frontend origin (HTTPS, no path).
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# PostgreSQL / Prisma
# ---------------------------------------------------------------------------
# Replace every placeholder. Never use these placeholder values to run
# migrations, create users, or query a real database.
#
# On Vercel/Neon, DATABASE_URL must be the POOLED connection string
# (hostname contains `-pooler`). Function instances reuse the pool, but Neon
# still multiplexes many short-lived instances, so pooling is required.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require

# Optional DIRECT (non-pooled) Neon connection used only by Prisma migration
# commands such as `npm run prisma:migrate:deploy`. The application runtime
# always uses DATABASE_URL. If unset, migration commands fall back to
# DATABASE_URL. Never expose this value to the frontend.
# DIRECT_DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require

# Maximum pg connections per warm function instance. Keep this small on
# serverless: 5 is the default, and Neon already pools at the proxy. Raising it
# multiplies connections across concurrent instances.
DATABASE_POOL_MAX=5

# ---------------------------------------------------------------------------
# Integration tests (optional; dedicated non-production database only)
# ---------------------------------------------------------------------------
# Must differ from DATABASE_URL. The database name must contain "test"; the test
# suite refuses to run otherwise. Never point this at production data.
TEST_DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME_test?sslmode=require

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Sessions use opaque random tokens stored as SHA-256 hashes in PostgreSQL.
# AUTH_SECRET also derives the encryption key for optional platform-admin
# multi-factor authentication (TOTP) secrets at rest. Development falls back to
# a clearly non-production key, but production must set a strong AUTH_SECRET
# before MFA enrollment is allowed.
AUTH_SECRET=REPLACE_ME

# Lifetime of a session cookie, in minutes.
AUTH_SESSION_TTL_MINUTES=60

# ---------------------------------------------------------------------------
# Transactional email (Brevo SMTP relay)
# ---------------------------------------------------------------------------
# All values are optional so the API can start in environments that do not send
# mail. When EMAIL_ENABLED=true the service validates the SMTP settings lazily
# and reports a sanitized status instead of crashing the API.
#
# Brevo SMTP settings are found in Brevo under Settings > SMTP & API > SMTP.
# Use the SMTP key (not the API key) as SMTP_PASS. Port 587 with SMTP_SECURE=false
# is the standard STARTTLS configuration.
#
# Authentication failures:
#   535 = wrong SMTP login/key. Copy the Login and SMTP key exactly.
#   525 = Unauthorized IP address. Brevo is blocking unknown IPs for SMTP keys.
#         Disable that blocking for this key or authorize the caller's egress IP.
#         Vercel uses dynamic egress IPs, so IP allow-listing is unreliable there.
#
# IMPORTANT: EMAIL_FROM_ADDRESS must be a sender verified in Brevo, or any address
# on a fully authenticated domain (Brevo does not require individual sender
# verification once the domain is authenticated). Recommended:
#   EMAIL_FROM_ADDRESS=no-reply@wisegrade.app
#   EMAIL_REPLY_TO=wiseempire62@gmail.com
#
# Never commit real SMTP credentials. EMAIL_FROM_NAME is the display name shown
# in the recipient's inbox. EMAIL_TEST_RECIPIENT restricts the administrator-only
# SMTP test endpoint to one verified address; when omitted, the signed-in
# platform administrator's own address is used.
#
# BACKEND_URL is the public API origin used by server-side integrations. Links in
# emails always use FRONTEND_URL, so production must set it to the deployed HTTPS
# frontend origin (never localhost).
EMAIL_ENABLED=false
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_BREVO_SMTP_LOGIN
SMTP_PASS=REPLACE_WITH_BREVO_SMTP_KEY
EMAIL_FROM_NAME=WiseGrade
EMAIL_FROM_ADDRESS=no-reply@wisegrade.app
EMAIL_REPLY_TO=wiseempire62@gmail.com
# EMAIL_TEST_RECIPIENT=verified-test-recipient@example.com
EMAIL_VERIFICATION_EXPIRY_HOURS=24
SUBJECT_TEACHER_ACCESS_CODE_EXPIRY_DAYS=7
# BACKEND_URL=https://wisegradebackend.vercel.app

# ---------------------------------------------------------------------------
# Scheduled transactional-email retries (outbox drain)
# ---------------------------------------------------------------------------
# The outbox stores every business email. Non-sensitive messages that fail to
# send are retried with backoff by a protected internal endpoint:
#   GET|POST /api/internal/email
#
# It is not a public send-anything endpoint: it only drains rows already created
# by verified business events. It fails closed (503) when CRON_SECRET is absent
# and rejects mismatched bearer tokens (401). Vercel Cron sends
# `Authorization: Bearer $CRON_SECRET` automatically.
#
# The included vercel.json schedule is daily (Hobby-compatible):
#   0 2 * * *
# On Vercel Pro, a more frequent schedule such as `*/15 * * * *` reduces retry
# latency. Keep the schedule and CALENDAR_SCHEDULER_INTERVAL_MINUTES consistent
# with the plan.
#
# Sensitive templates (verification links, temporary passwords, access codes)
# are never retried with redacted payloads. They fail permanently and require a
# fresh resend or reissue.
#
# The same CRON_SECRET protects the calendar scheduler endpoint.

# ---------------------------------------------------------------------------
# Automatic academic calendar
# ---------------------------------------------------------------------------
# The scheduler opens and closes terms, prepares reports and finalizes academic
# years using the Africa/Accra calendar. It starts after the first interval so
# the API can boot without opening a database connection.
#
# Local development (src/index.ts) runs an in-process interval timer.
# Production on Vercel must NOT use an interval: Vercel Cron calls the
# protected `GET /api/internal/calendar` endpoint once per scheduled run. That
# endpoint is authenticated with CRON_SECRET and guarded by a PostgreSQL lease
# so overlapping or duplicated invocations only run once.
#
# Configure CRON_SECRET to the same value in the Vercel project. Vercel Cron
# sends `Authorization: Bearer $CRON_SECRET` automatically. The endpoint fails
# closed (503) when CRON_SECRET is absent, and production refuses to start when
# the scheduler is enabled without a secret.
#
# Set CALENDAR_SCHEDULER_INTERVAL_MINUTES to the real cron cadence so the
# platform health check correctly reports a stale scheduler. The included
# vercel.json cron runs daily (Hobby-compatible), so use 1440 in production.
# Vercel Pro can run a more frequent schedule; change vercel.json and this value
# together. An external worker may call the same endpoint with the bearer token.
CALENDAR_SCHEDULER_ENABLED=true
CALENDAR_SCHEDULER_INTERVAL_MINUTES=60
# CRON_SECRET=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_16_CHARACTERS

# ---------------------------------------------------------------------------
# Optional reverse geocoding for the dashboard location indicator
# ---------------------------------------------------------------------------
# The browser never calls a geocoding provider directly. When a signed-in user
# explicitly asks to detect their location, the coordinates are sent once to
# this API, which forwards them to the provider below and returns a place name.
# Coordinates are not logged, cached or persisted. Leave these unset to use the
# public OpenStreetMap Nominatim endpoint, which needs no API key but requires a
# descriptive User-Agent. Point REVERSE_GEOCODING_URL at a self-hosted Nominatim
# instance or another Nominatim-compatible service to avoid the public endpoint.
# If the provider requires a key, set REVERSE_GEOCODING_API_KEY; it stays on the
# server and is never included in the frontend bundle.
#
# REVERSE_GEOCODING_URL=https://nominatim.openstreetmap.org/reverse
# REVERSE_GEOCODING_API_KEY=
# REVERSE_GEOCODING_USER_AGENT=WiseGrade-LocationLookup/1.0 (https://example.com)

# ---------------------------------------------------------------------------
# Private Cloudflare R2 storage for report PDFs and branding assets
# ---------------------------------------------------------------------------
# All four values are required together in production. The bucket must remain
# private: report PDFs and school images are served only through authenticated
# backend routes, never through a public bucket URL. When these values are
# absent in development/test, Gradely uses private local storage under
# backend/.storage instead. Production fails loudly without R2.
R2_ACCOUNT_ID=REPLACE_ME
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_BUCKET_NAME=REPLACE_ME

# ---------------------------------------------------------------------------
# Payments (provider-neutral foundation; mock provider for non-production only)
# ---------------------------------------------------------------------------
# No real provider is integrated and no real credentials are included.
# Set PAYMENT_PROVIDER=mock (with NODE_ENV not production) to enable the
# development mock provider for online-payment flow tests. The mock never moves
# money and is disabled in production.
#
# PAYMENT_SECRET_KEY is reserved for a future real provider. PAYMENT_WEBHOOK_SECRET
# is required by the mock provider and is used to verify HMAC-SHA256 signatures
# over "${timestamp}.${rawBody}". Use a private random value; never commit it.
#
# Uncomment both lines below to enable the mock locally, then replace the secret.
# PAYMENT_PROVIDER=mock
# PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_PRIVATE_RANDOM_VALUE
PAYMENT_SECRET_KEY=REPLACE_ME
